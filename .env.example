# TopoBench local environment template.
#
# Copy to `.env` and fill only the providers/models you plan to run:
#   cp .env.example .env
#
# API key variables accept comma-separated pools. Keep paid and free pools
# separate so batch jobs cannot spend paid quota on free-tier model runs.

# ── Proprietary model pools ────────────────────────────────────────────────
# Models routed through paid OpenAI-compatible APIs: gpt_*
OPENAI_PAID_API_KEYS=
# Leave blank to use the official OpenAI endpoint; set for a proxy/compatible endpoint.
# OPENAI_BASE_URL=

# Seedance 2.0 Mini image-to-video via mainland-China Volcengine Ark.
VOLCENGINE_API_KEY=

# Models: gemini_3_1_pro, gemini_3_1_flash_lite
GOOGLE_PAID_API_KEYS=

# Model: gemini_3_flash
GOOGLE_FREE_API_KEYS=

# ── Hosted open-weight / free-tier pools ──────────────────────────────────
# Model: internvl
INTERNVL_API_KEYS=

# Model: qvq
MODELSCOPE_API_KEYS=

# Models: qwen_vl_max
DASHSCOPE_API_KEYS=

# Optional DashScope paid Qwen models.
QWEN_PAID_API_KEYS=

# Models: qwen3_5_plus_proxy
QWEN_PROXY_API_KEYS=
# Required when using qwen3_5_plus_proxy.
# QWEN_PROXY_BASE_URL=

# Models: nemotron and other NVIDIA NIM routes
NVIDIA_NIM_API_KEYS=

# Model: minicpm
MINICPM_V_4_5_NIM_API_KEYS=

# Model: gemma
GEMMA_4_31B_IT_BASE_URL=
GEMMA_4_31B_IT_API_KEYS=

# Models: qwen, nemotron, llama, mistral_14b, and other OpenRouter routes
OPENROUTER_API_KEYS=

# Optional legacy/extra hosted providers.
ZHIPU_API_KEYS=

# ── Self-hosted open-weight models ────────────────────────────────────────
# Cosmos-Reason2-8B via local NVIDIA NIM.
COSMOS_REASON2_BASE_URL=http://127.0.0.1:8000/v1
COSMOS_REASON2_API_KEYS=EMPTY

# BAGEL-7B-MoT via vLLM-Omni plus the TopoBench proxy.
BAGEL_BASE_URL=http://127.0.0.1:8011/v1
BAGEL_UPSTREAM_BASE_URL=http://127.0.0.1:8001/v1
BAGEL_API_KEYS=EMPTY

# ThinkMorph-7B via the TopoBench OpenAI-compatible proxy.
THINKMORPH_BASE_URL=http://127.0.0.1:8002/v1
THINKMORPH_API_KEYS=EMPTY

# ── Optional local runtime knobs ──────────────────────────────────────────
# If your VPN/proxy is configured only in macOS/browser settings, Python
# subprocesses may still time out on Google/OpenAI endpoints. Copy the values
# your proxy client exposes here, for example:
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7891
# TOPOBENCH_PROVIDER_PREFLIGHT_TIMEOUT=10
# TOPOBENCH_SKIP_PROVIDER_PREFLIGHT=0
LMMS_EVAL_HOME=
EXPECTED_CONDA_ENV=
