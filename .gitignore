/.deps/
/models/

# IDE / editor junk
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Evaluation outputs, logs, and caches
logs/
lmms_eval_tasks/cache/
lmms_eval_tasks/logs/
topobench_eval/*.egg-info/
topobench_eval/build/
topobench_eval/dist/

# Generated environment assets and benchmark outputs.
# Keep the fixed question.jsonl under each environments/<task>/output/;
# ignore the regenerated images and any other generated artifacts beside it.
environments/*/output/*
!environments/*/output/
!environments/*/output/question.jsonl
environments/*/output_*/
environments/*/output/*.zip
environments/*/*.zip

# ai2thor runtime cache for continuity_3d_maze
environments/*/.thor_runtime/
